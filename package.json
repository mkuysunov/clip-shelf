{
  "name": "clipshelf",
  "productName": "ClipShelf",
  "version": "0.1.0",
  "description": "Лёгкий менеджер истории буфера обмена (текст и изображения) в стиле Paste",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -b electron && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:${DEV_PORT:-5173} && cross-env NODE_ENV=development electron .\"",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "io.clipshelf.app",
    "productName": "ClipShelf",
    "directories": {
      "output": "release"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/.tsbuildinfo",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "ClipShelf needs this to paste the selected item into the active app."
      },
      "icon": "build/icon.png"
    }
  }
}
